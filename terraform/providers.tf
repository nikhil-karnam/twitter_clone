terraform {
  backend "s3" {
    bucket       = "twitter-clone-tfstate-905765459973"
    key          = "terraform.tfstate"
    region       = "us-east-2"
    use_lockfile = true
  }

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = "us-east-2"
}
